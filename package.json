{
  "name": "sfa-tg-app",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test:ui": "pnpm build && playwright test",
    "test:connectors": "node --test scripts/mcp/*.test.mjs scripts/bot-profile.test.mjs scripts/channel-post.test.mjs",
    "test:migrations": "node --test scripts/multiple-groups-migration.test.mjs scripts/game-statistics-migration.test.mjs",
    "test:migrations:games": "node --test scripts/game-statistics-migration.test.mjs",
    "bot:profile": "node scripts/bot-profile.mjs",
    "channel:post": "node scripts/channel-post.mjs",
    "mcp:telegram": "node scripts/mcp/telegram.mjs",
    "check:telegram": "node scripts/mcp/check-telegram.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm --filter @altynka/miniapp build && pnpm --filter @altynka/worker exec wrangler deploy",
    "build": "pnpm --filter @altynka/miniapp build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "typescript": "5.9.3"
  }
}
