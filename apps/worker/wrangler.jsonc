{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fc-altynka",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": { "crons": ["*/5 * * * *"] },
	// D1 lives in EEUR and one API request makes many sequential queries: run the Worker next to it, not next to
	// the players in Almaty. Smart Placement never moved it (almost all traffic comes from one location), so the
	// region is explicit; Frankfurt is also next to Telegram's Bot API. See docs/security-hardening-deployment.md.
	"placement": { "mode": "targeted", "region": "aws:eu-central-1" },
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 }
	},
	// Per Telegram user (key `tg:<id>`), see auth/middleware.ts. namespace_id is unique within the account.
	"ratelimits": [
		{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
		{ "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fc-altynka",
			"database_id": "836b706d-84ae-49a0-8afb-2b7d2c6097e3",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVENT_SYNC",
				"class_name": "EventSync"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"EventSync"
			]
		}
	],
	"assets": {
		"directory": "../miniapp/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/tg/*"
		]
	},
	// Set with `wrangler secret put`; listed here so `wrangler types` knows them without a local .dev.vars.
	"secrets": { "required": ["BOT_TOKEN", "WEBHOOK_SECRET"] },
	"vars": {
		"BOT_USERNAME": "fc_altynka_bot",
		"MINIAPP_SHORT_NAME": "fc_altynka_app",
		"ADMIN_TG_ID": "1008342008"
	}
}
